---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import Pagination from '../components/Pagination.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers, getGamesPage } from '../lib/games';
import { PAGE_SIZE } from '../lib/pagination';

export const prerender = true;

const result = await getGamesPage(getDatabase(), 1, PAGE_SIZE);
const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const selectedCategories = Astro.url.searchParams.getAll('category');
const selectedPublisher = Astro.url.searchParams.get('publisher');
const activeFilterCount = selectedCategories.length + (selectedPublisher ? 1 : 0);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-2xl border border-slate-700 bg-slate-900/60 p-6 shadow-lg">
      <form method="get" action="/" data-testid="game-filters-form" aria-label="Game filter controls" class="space-y-6">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <fieldset class="flex-1">
            <legend class="mb-3 text-sm font-medium uppercase tracking-[0.18em] text-slate-300">Categories</legend>
            <div class="flex flex-wrap gap-3">
              {categories.map((category) => (
                <label
                  class="flex cursor-pointer items-center gap-2 rounded-full border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500 hover:text-blue-300 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none"
                  data-testid={`category-filter-label-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
                >
                  <input
                    type="checkbox"
                    name="category"
                    value={category}
                    checked={selectedCategories.includes(category)}
                    class="h-4 w-4 rounded border-slate-500 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid={`category-filter-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
                  />
                  <span>{category}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="w-full max-w-xs">
            <label for="publisher-filter" class="mb-2 block text-sm font-medium uppercase tracking-[0.18em] text-slate-300">
              Publisher
            </label>
            <select
              id="publisher-filter"
              name="publisher"
              value={selectedPublisher ?? ''}
              class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={publisher}>{publisher}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            type="submit"
            class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
            data-testid="apply-filters-button"
          >
            Apply filters
          </button>
          <a
            href="/"
            class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-100 transition-colors hover:border-slate-500 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
            data-testid="clear-filters-link"
          >
            Clear filters
          </a>
          {activeFilterCount > 0 && (
            <span class="text-sm text-slate-300" data-testid="game-results-count">
              {activeFilterCount} filter{activeFilterCount === 1 ? '' : 's'} active
            </span>
          )}
        </div>
      </form>
    </div>

    <div>
      <h2 class="mb-6 text-2xl font-medium text-slate-100">Featured Games</h2>

      {result.games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid" data-page-size={PAGE_SIZE}>
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div hidden data-testid="empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}

      <div class="mt-8">
        <Pagination currentPage={result.page} totalPages={result.totalPages} />
      </div>
    </div>
  </div>

  <script>
    const gameGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const emptyState = document.querySelector<HTMLElement>('[data-testid="empty-state"]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const pageSize = Number(gameGrid?.dataset.pageSize ?? '0');
    const categoryCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisherSelect = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');

    function readQueryState() {
      const params = new URLSearchParams(window.location.search);
      const selectedCategories = params.getAll('category');
      const selectedPublisher = params.get('publisher');

      categoryCheckboxes.forEach((checkbox) => {
        checkbox.checked = selectedCategories.includes(checkbox.value);
      });

      if (publisherSelect) {
        publisherSelect.value = selectedPublisher ?? '';
      }
    }

    function applyFilters() {
      const params = new URLSearchParams(window.location.search);
      const selectedCategories = params.getAll('category');
      const selectedPublisher = params.get('publisher');
      const hasActiveFilters = selectedCategories.length > 0 || Boolean(selectedPublisher);
      let visibleCount = 0;

      cards.forEach((card, index) => {
        const categoryMatches = selectedCategories.length === 0 || selectedCategories.includes(card.dataset.gameCategory ?? '');
        const publisherMatches = !selectedPublisher || (card.dataset.gamePublisher ?? '') === selectedPublisher;
        const isVisible = categoryMatches && publisherMatches && (hasActiveFilters || pageSize === 0 || index < pageSize);

        card.hidden = !isVisible;
        card.setAttribute('aria-hidden', String(!isVisible));
        if (isVisible) visibleCount += 1;
      });

      if (gameGrid) {
        gameGrid.hidden = visibleCount === 0;
      }

      if (emptyState) {
        emptyState.hidden = visibleCount !== 0;
      }
    }

    function updateUrlFromSelection() {
      const params = new URLSearchParams(window.location.search);
      params.delete('category');
      params.delete('publisher');

      categoryCheckboxes.forEach((checkbox) => {
        if (checkbox.checked) {
          params.append('category', checkbox.value);
        }
      });

      if (publisherSelect && publisherSelect.value) {
        params.set('publisher', publisherSelect.value);
      }

      const queryString = params.toString();
      const nextUrl = `${window.location.pathname}${queryString ? `?${queryString}` : ''}`;
      window.history.replaceState({}, '', nextUrl);
    }

    function handleFilterChange() {
      updateUrlFromSelection();
      applyFilters();
    }

    if (categoryCheckboxes.length > 0) {
      categoryCheckboxes.forEach((checkbox) => {
        checkbox.addEventListener('change', handleFilterChange);
      });
    }

    if (publisherSelect) {
      publisherSelect.addEventListener('change', handleFilterChange);
    }

    readQueryState();
    applyFilters();
  </script>
</Layout>
