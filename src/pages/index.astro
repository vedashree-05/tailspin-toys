---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import Pagination from '../components/Pagination.astro';
import { getDatabase } from '../lib/db';
import { getGamesPage } from '../lib/games';
import { PAGE_SIZE } from '../lib/pagination';

export const prerender = true;

const result = await getGamesPage(getDatabase(), 1, PAGE_SIZE);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="mb-6 text-2xl font-medium text-slate-100">Featured Games</h2>

      {result.games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {result.games.map((game) => <GameCard game={game} />)}
        </div>
      )}

      <div class="mt-8">
        <Pagination currentPage={result.page} totalPages={result.totalPages} />
      </div>
    </div>
  </div>
</Layout>
